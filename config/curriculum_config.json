      "id": "chain-cos-cube",
      "topic": "chain",
      "tag": "Regla de la cadena",
      "question": "Encuentra la derivada: y = cos(x^3)",
      "answer": "-3x^2sin(x^3)",
      "aliases": ["-3x²sin(x³)"],
      "hint": "Identifica x^3 como la función interior.",
      "steps": [
        "u=x^3 y u'=3x^2.",
        "d/dx[cos(u)] = -sin(u)u'.",
        "y'=-3x^2sin(x^3)."
      ]
    },
    {
      "id": "chain-sin-polynomial",
      "topic": "chain",
      "tag": "Regla de la cadena",
      "question": "Encuentra f'(x) si f(x)=sin(x^2+9x+8).",
      "answer": "cos(x^2+9x+8)(2x+9)",
      "aliases": ["(2x+9)cos(x²+9x+8)"],
      "hint": "La parte interior es x^2+9x+8.",
      "steps": [
        "u=x^2+9x+8.",
        "u'=2x+9.",
        "f'(x)=cos(u)u'."
      ]
    },
